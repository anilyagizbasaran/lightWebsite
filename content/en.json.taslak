    "baslik": "Installation",
    "adimlar": [
      {
        "ad": "Pick the height",
        "govde": "Mount it 30 cm above the door, 2.4-3.0 m off the ground. Higher grows the range, and the blind circle with it."
      },
      {
        "ad": "Run the cable",
        "govde": "The 12 V supply and the dry contact cable run through the channel in the back plate. Flush or surface, either works."
      },
      {
        "ad": "Adjust the range",
        "govde": "Walk in front of the door - the app shows the trip instantly. Narrow or widen the cone with the screw."
