<!DOCTYPE html>
{{html_dil}}
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
{{meta_baslik}}
{{meta_aciklama}}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,400..900&family=Azeret+Mono:wght@400;500&display=swap" rel="stylesheet">
{{css}}
</head>
<body>
{{atla}}

<header class="topbar">
  <a class="brand" href="#top">
    <svg class="brand-mark" viewBox="0 0 34 20" aria-hidden="true">
      <rect x="1" y="2" width="32" height="5" rx="1.5"/>
      <path d="M5 9 L29 9 L33 19 L1 19 Z" class="brand-beam"/>
    </svg>
    {{marka}}
  </a>
  {{topnav}}
  <!-- Telefonda .topnav gizli; onsuz bölümlere geçilemiyor, ziyaretci
       4500 px'lik sahnenin arkasinda kilitli kaliyordu. -->
  <button class="menu-btn" id="menuBtn" type="button"
          {{menu_buton}}
    <span class="menu-ico" aria-hidden="true"><i></i><i></i><i></i></span>
  </button>
</header>

<div class="mobnav" id="mobileNav" hidden>
  {{mobnav}}
</div>

<!-- ============================================================
     TEKNIK DEGERLER: TEK LISTE.
     Kanonik kaynak "Teknik degerler" tablosu (#teknik). Ayni sayi
     baska bolumlerde de goruntulendigi icin bir deger degisince
     hepsinin degismesi gerekiyor. Asagida her deger ve gectigi
     yerler; satir numarasi yok cunku ilk duzenlemede bayatlar.

       2400 lumen      -> #teknik | kapak deger seridi | #caydirma
                          3. kademe | akt 4 kopyasi (dolayli)
       5000 K          -> #teknik | kapak deger seridi
       14 m menzil     -> #teknik | kapak deger seridi | meta
                          description | akt 3 etiketi
       6 m ve 3 m      -> akt 1 ve akt 2 kopyasi | HUD bolge
                          etiketleri (scene.js)
       IP66            -> #teknik | kapak deger seridi
       0,6 W bekleme   -> #teknik | kapak deger seridi | kapak
                          cumlesi | akt 4 kopyasi | akt 4 etiketi
       22 W tam guc    -> #teknik
       100 atim/dk     -> #teknik | akt 2 etiketi
       1,4 Hz nabiz    -> #teknik | akt 1 etiketi
                          DIKKAT: bu sayi scene.js'teki nabiz
                          egrisinden geliyor (sin(now*0,009) ->
                          1,43 Hz). Degistirilecekse egri de
                          degismeli, yoksa yazan sey ekranda
                          olanla ortusmez.
       30 saniye       -> #teknik | akt 3 kopyasi
       800x62x46 mm    -> #teknik
       110 derece PIR  -> #teknik | #algilama hesaplayicisi
                          (ui.js icindeki koni matematigi)

     Bu sayilar simdilik TASARIM DEGERI; gercek urun olcumleriyle
     dogrulanmadi. Dogrulanirken ilk bakilacaklar en iyimser
     olanlar: 2400 lumen (22 W'ta 109 lm/W) ve 14 m PIR menzili
     (bu sinifta tipik olan 8-12 m).
     ============================================================ -->

<main id="top">

<!-- ============ SAHNE ============ -->
<section class="tunnel" id="tunnel">
  <div class="stage" id="stage">

    <svg class="stage-art" id="art" viewBox="0 0 1440 810" preserveAspectRatio="xMidYMax slice" aria-hidden="true">
      <defs>
        <filter id="fSoft" x="-35%" y="-35%" width="170%" height="170%"
                color-interpolation-filters="sRGB">
          <feGaussianBlur stdDeviation="9"/>
        </filter>
        <filter id="fMed" x="-35%" y="-35%" width="170%" height="170%"
                color-interpolation-filters="sRGB">
          <feGaussianBlur stdDeviation="4"/>
        </filter>
        <!-- Etiket golge plakasi icin: kenari dagitan bulaniklik -->
        <filter id="fPlate" x="-20%" y="-40%" width="140%" height="180%"
                color-interpolation-filters="sRGB">
          <feGaussianBlur stdDeviation="7"/>
        </filter>
        <filter id="fTight" x="-80%" y="-500%" width="260%" height="1100%"
                color-interpolation-filters="sRGB">
          <feGaussianBlur stdDeviation="2.6"/>
        </filter>

        <!-- Kirmizi: yuzey yikamasi. Barin ALTINDA tepe yapan sicak
             leke + kapi boyunca sonen genis leke + zeminde one dogru
             uzayan havuz. Havada koni YOK. -->
        <!-- Tepe lekesi: cekirdegi beyaza yakin (kirpilmis),
             kenari doygun. -->
        <radialGradient id="gNearR">
          <stop offset="0" stop-color="#FFD7DC" stop-opacity=".95"/>
          <stop offset=".38" stop-color="#FF2536" stop-opacity=".62"/>
          <stop offset="1" stop-color="#FF2536" stop-opacity="0"/>
        </radialGradient>
        <!-- Olculen sonme 2,0 kat (y 500..660: 181 -> 90).
             Ust stop BEYAZA YAKIN: kaynagin hemen altinda
             olculen tepe luminans 225..241, yani kirpilmis.
             Doygunluk ancak isik sondukce geliyor. -->
        <linearGradient id="gFanR" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#FFD7DC" stop-opacity=".72"/>
          <stop offset=".18" stop-color="#FF2536" stop-opacity=".58"/>
          <stop offset=".55" stop-color="#FF2536" stop-opacity=".44"/>
          <stop offset="1" stop-color="#A8101F" stop-opacity=".30"/>
        </linearGradient>
        <radialGradient id="gGndR">
          <stop offset="0" stop-color="#FF3A48" stop-opacity=".62"/>
          <stop offset=".5" stop-color="#FF2536" stop-opacity=".32"/>
          <stop offset="1" stop-color="#FF2536" stop-opacity="0"/>
        </radialGradient>
        <radialGradient id="gGndHotR">
          <stop offset="0" stop-color="#FFFFFF" stop-opacity=".54"/>
          <stop offset=".5" stop-color="#FF3A48" stop-opacity=".30"/>
          <stop offset="1" stop-color="#FF2536" stop-opacity="0"/>
        </radialGradient>
        <radialGradient id="gBloomR">
          <stop offset="0" stop-color="#FFFFFF" stop-opacity=".85"/>
          <stop offset=".4" stop-color="#FF3A48" stop-opacity=".50"/>
          <stop offset="1" stop-color="#FF2536" stop-opacity="0"/>
        </radialGradient>
        <radialGradient id="gTintR">
          <stop offset="0" stop-color="#FF6A5C" stop-opacity=".80"/>
          <stop offset=".5" stop-color="#FF8578" stop-opacity=".46"/>
          <stop offset="1" stop-color="#FFFFFF" stop-opacity="0"/>
        </radialGradient>
        <!-- Mavi: yuzey yikamasi. Barin ALTINDA tepe yapan sicak
             leke + kapi boyunca sonen genis leke + zeminde one dogru
             uzayan havuz. Havada koni YOK. -->
        <!-- Tepe lekesi: cekirdegi beyaza yakin (kirpilmis),
             kenari doygun. -->
        <radialGradient id="gNearB">
          <stop offset="0" stop-color="#D8E6FF" stop-opacity=".95"/>
          <stop offset=".38" stop-color="#2472FF" stop-opacity=".62"/>
          <stop offset="1" stop-color="#2472FF" stop-opacity="0"/>
        </radialGradient>
        <!-- Olculen sonme 2,0 kat (y 500..660: 181 -> 90).
             Ust stop BEYAZA YAKIN: kaynagin hemen altinda
             olculen tepe luminans 225..241, yani kirpilmis.
             Doygunluk ancak isik sondukce geliyor. -->
        <linearGradient id="gFanB" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#D8E6FF" stop-opacity=".72"/>
          <stop offset=".18" stop-color="#2472FF" stop-opacity=".58"/>
          <stop offset=".55" stop-color="#2472FF" stop-opacity=".44"/>
          <stop offset="1" stop-color="#0C2F96" stop-opacity=".30"/>
        </linearGradient>
        <radialGradient id="gGndB">
          <stop offset="0" stop-color="#3C8AFF" stop-opacity=".62"/>
          <stop offset=".5" stop-color="#2472FF" stop-opacity=".32"/>
          <stop offset="1" stop-color="#2472FF" stop-opacity="0"/>
        </radialGradient>
        <radialGradient id="gGndHotB">
          <stop offset="0" stop-color="#FFFFFF" stop-opacity=".54"/>
          <stop offset=".5" stop-color="#3C8AFF" stop-opacity=".30"/>
          <stop offset="1" stop-color="#2472FF" stop-opacity="0"/>
        </radialGradient>
        <radialGradient id="gBloomB">
          <stop offset="0" stop-color="#FFFFFF" stop-opacity=".85"/>
          <stop offset=".4" stop-color="#3C8AFF" stop-opacity=".50"/>
          <stop offset="1" stop-color="#2472FF" stop-opacity="0"/>
        </radialGradient>
        <radialGradient id="gTintB">
          <stop offset="0" stop-color="#7C9AFF" stop-opacity=".80"/>
          <stop offset=".5" stop-color="#9AB2FF" stop-opacity=".46"/>
          <stop offset="1" stop-color="#FFFFFF" stop-opacity="0"/>
        </radialGradient>

        <!-- ============================================================
             PERDE. Taban karede kapi isigi ACIK ve tam gucte. Perde iki
             is yapiyor: beklemede kismi (isik kisik okunuyor), alarmda
             tam (beyaz soner, yerini cakar alir). Isigin dustugu yere
             radyal oturuyor, yani karartma isigin kendi sekline uyuyor.
             ============================================================ -->
        <radialGradient id="gVeil">
          <stop offset="0" stop-color="#04070D" stop-opacity="1"/>
          <stop offset=".55" stop-color="#04070D" stop-opacity=".92"/>
          <stop offset="1" stop-color="#04070D" stop-opacity="0"/>
        </radialGradient>

        <!-- Vinyet: odak kapi ustundeki isik olsun. Olculen rakipler
             sagdaki bahce armaturu, soldaki esi ve samanyolu bandi. -->
        <radialGradient id="gVigHole">
          <stop offset="0" stop-color="#000" stop-opacity="1"/>
          <stop offset=".58" stop-color="#000" stop-opacity="1"/>
          <stop offset="1" stop-color="#000" stop-opacity="0"/>
        </radialGradient>
        <mask id="mVig" maskUnits="userSpaceOnUse" x="-900" y="-500" width="3200" height="1800">
          <rect x="-900" y="-500" width="3200" height="1800" fill="#fff"/>
          <ellipse cx="387" cy="580" rx="470" ry="400" fill="url(#gVigHole)"/>
        </mask>
      </defs>

      <!-- ============================================================
           SAHNE. 100 birim = 1 metre, zemin y=676, kapi ekseni x=386.
           Olcum (s8bf87): kapi 138x263 px -> 145,3 px/metre,
           K=0,68841, OX=-557,8, OY=-221,0.
           Bar dunyada x 338..445 / y 440..458, kapi x 338..434 / 495..676.
           Zoom kapali: bu kadraj bastan sona sabit.
           ============================================================ -->
      <rect x="-900" y="-500" width="3200" height="1800" fill="#0A0E16"/>
      {{sahne_resmi}}

      <rect id="vignette" x="-900" y="-500" width="3200" height="1800"
            fill="#04070D" opacity=".76" mask="url(#mVig)"/>

      <!-- Kisik mod ve alarmda beyazi bastirma: tek perde iki is. -->
      <ellipse id="veil" cx="387" cy="545" rx="330" ry="290"
               fill="url(#gVeil)" opacity="0"/>

      <g id="lRed" class="rig" opacity="0">
        <!-- 1. zeminde ONE uzayan havuz: olculen katki y=685'te 124,
                y=835'te 44. Genis ve one dogru, dar elips degil. -->
        <ellipse cx="368" cy="742" rx="300" ry="120" fill="url(#gGndR)" filter="url(#fSoft)"/>
        <ellipse cx="368" cy="700" rx="168" ry="48" fill="url(#gGndHotR)" filter="url(#fMed)"/>
        <!-- 2. DUVARDAKI YELPAZE. Olculen yanal yayilim:
                y=500 -> x 210..570,  y=620 -> x 180..630.
                Yani agizda dar, asagi dogru genisliyor. Elips
                bunu veremiyor (kendi merkezinde en genis),
                o yuzden yanlari kavisli bir yol. Dikey gradyan
                olculen sonmeyi izliyor: tepe 186 -> kapi dibi 70,
                yani %38. -->
        <!-- Yelpaze, OLCULEN yari genisliklerle:
             y=440 -> 42,  y=500 -> 180,  y=620 -> 225,  y=676 -> 245.
             Armaturun hemen altinda hizla aciliyor, sonra yavas
             genisliyor: duvar yikayici armaturun imzasi. -->
        <path d="M326,425 C188,500 143,620 123,676
                 L613,676 C593,620 548,500 410,425 Z"
              fill="url(#gFanR)" filter="url(#fSoft)"/>
        <!-- 3. agzin hemen altindaki tepe (olculen tepe y=460) -->
        <ellipse cx="368" cy="455" rx="116" ry="60" fill="url(#gNearR)" filter="url(#fMed)"/>
        <!-- 4. kaynak: uc kademeli bloom + patlak agiz -->
        <ellipse cx="368" cy="421" rx="240" ry="78" fill="url(#gBloomR)" filter="url(#fSoft)" opacity=".34"/>
        <ellipse cx="368" cy="421" rx="126" ry="42" fill="url(#gBloomR)" filter="url(#fSoft)"/>
        <rect x="346" y="417" width="42" height="8" rx="4" fill="#FFFFFF" filter="url(#fTight)"/>
      </g>
      <g id="lRedT" class="tint" opacity="0">
        <ellipse cx="368" cy="556" rx="224" ry="182" fill="url(#gTintR)" filter="url(#fSoft)"/>
        <ellipse cx="368" cy="730" rx="280" ry="110" fill="url(#gTintR)" filter="url(#fSoft)"/>
      </g>
      <g id="lBlue" class="rig" opacity="0">
        <!-- 1. zeminde ONE uzayan havuz: olculen katki y=685'te 124,
                y=835'te 44. Genis ve one dogru, dar elips degil. -->
        <ellipse cx="408" cy="742" rx="300" ry="120" fill="url(#gGndB)" filter="url(#fSoft)"/>
        <ellipse cx="408" cy="700" rx="168" ry="48" fill="url(#gGndHotB)" filter="url(#fMed)"/>
        <!-- 2. DUVARDAKI YELPAZE. Olculen yanal yayilim:
                y=500 -> x 210..570,  y=620 -> x 180..630.
                Yani agizda dar, asagi dogru genisliyor. Elips
                bunu veremiyor (kendi merkezinde en genis),
                o yuzden yanlari kavisli bir yol. Dikey gradyan
                olculen sonmeyi izliyor: tepe 186 -> kapi dibi 70,
                yani %38. -->
        <!-- Yelpaze, OLCULEN yari genisliklerle:
             y=440 -> 42,  y=500 -> 180,  y=620 -> 225,  y=676 -> 245.
             Armaturun hemen altinda hizla aciliyor, sonra yavas
             genisliyor: duvar yikayici armaturun imzasi. -->
        <path d="M366,425 C228,500 183,620 163,676
                 L653,676 C633,620 588,500 450,425 Z"
              fill="url(#gFanB)" filter="url(#fSoft)"/>
        <!-- 3. agzin hemen altindaki tepe (olculen tepe y=460) -->
        <ellipse cx="408" cy="455" rx="116" ry="60" fill="url(#gNearB)" filter="url(#fMed)"/>
        <!-- 4. kaynak: uc kademeli bloom + patlak agiz -->
        <ellipse cx="408" cy="421" rx="240" ry="78" fill="url(#gBloomB)" filter="url(#fSoft)" opacity=".34"/>
        <ellipse cx="408" cy="421" rx="126" ry="42" fill="url(#gBloomB)" filter="url(#fSoft)"/>
        <rect x="388" y="417" width="42" height="8" rx="4" fill="#FFFFFF" filter="url(#fTight)"/>
      </g>
      <g id="lBlueT" class="tint" opacity="0">
        <ellipse cx="408" cy="556" rx="224" ry="182" fill="url(#gTintB)" filter="url(#fSoft)"/>
        <ellipse cx="408" cy="730" rx="280" ry="110" fill="url(#gTintB)" filter="url(#fSoft)"/>
      </g>

      <!-- ============================================================
           FAZA GORE ETIKETLER. Bilgi duz metinde degil, sahnenin
           ilgili yerine bakan bir cizgide. Hepsi OLCULEN noktalari
           gosteriyor: armatur x 349..433 / y 419..440, difuzor
           424..432, kapi 338..434 / 495..676, zemin 676, isik
           ekseni 387. Gorunurlugu .stage[data-act] suruyor.
           ============================================================ -->
      <g class="anno anno-1">
        <!-- Golge plakasi: W3C G18. Olculdu, arka planin en
             parlak yerinde saf beyaz bile 3,48:1 kaliyordu;
             a=0,72 ile —chalk 6,4:1, alt satir 4,8:1 oluyor.
             Bulanik, cunku keskin kutu fotografin uzerinde
             yabanci duruyor. -->
        <rect class="anno-plate" x="64" y="442" width="180" height="42" rx="8"/>
        <circle cx="318" cy="498" r="2.5"/>
        <line x1="314" y1="498" x2="240" y2="463"/>
        {{etiket_1}}
      </g>

      <g class="anno anno-2">
        <!-- Golge plakasi: W3C G18. Olculdu, arka planin en
             parlak yerinde saf beyaz bile 3,48:1 kaliyordu;
             a=0,72 ile —chalk 6,4:1, alt satir 4,8:1 oluyor.
             Bulanik, cunku keskin kutu fotografin uzerinde
             yabanci duruyor. -->
        <rect class="anno-plate" x="74" y="368" width="196" height="42" rx="8"/>
        <circle cx="344" cy="424" r="2.5"/>
        <line x1="340" y1="424" x2="266" y2="389"/>
        {{etiket_2}}
      </g>

      <g class="anno anno-3">
        <!-- Golge plakasi: W3C G18. Olculdu, arka planin en
             parlak yerinde saf beyaz bile 3,48:1 kaliyordu;
             a=0,72 ile —chalk 6,4:1, alt satir 4,8:1 oluyor.
             Bulanik, cunku keskin kutu fotografin uzerinde
             yabanci duruyor. -->
        <rect class="anno-plate" x="-6" y="621" width="176" height="42" rx="8"/>
        <circle cx="240" cy="676" r="2.5"/>
        <line x1="236" y1="676" x2="166" y2="642"/>
        {{etiket_3}}
      </g>

      <g class="anno anno-4">
        <!-- Golge plakasi: W3C G18. Olculdu, arka planin en
             parlak yerinde saf beyaz bile 3,48:1 kaliyordu;
             a=0,72 ile —chalk 6,4:1, alt satir 4,8:1 oluyor.
             Bulanik, cunku keskin kutu fotografin uzerinde
             yabanci duruyor. -->
        <rect class="anno-plate" x="92" y="365" width="180" height="42" rx="8"/>
        <circle cx="346" cy="421" r="2.5"/>
        <line x1="342" y1="421" x2="268" y2="386"/>
        {{etiket_4}}
      </g>

    </svg>

    <div class="strobe" id="strobe" aria-hidden="true"><i class="s-r"></i><i class="s-b"></i></div>

    <!-- Bolum gostergesi: 6 ekranlik tunelde nerede oldugunu soyler ve
         tiklayinca o ana atlar. Zeminden kaldirilan mesafe esiklerinin
         yerini de dolduruyor. -->
    {{beatler}}

    <!-- Okunabilirlik perdesi iki katman: kolon icin sagdan,
         kapak icin yukaridan. Tek elemanda gradyani degistirmek
         sert bir kesme yapiyordu (background-image gecis kabul
         etmiyor); iki katman opaklikla capraz geciyor. -->
    <i class="copy-scrim scrim-side" aria-hidden="true"></i>
    <i class="copy-scrim scrim-cover" aria-hidden="true"></i>

      <!-- ============================================================
           KAPAK. Ilk ekran bir urun kapagi gibi kuruluyor: eyebrow,
           baslik, kapsayici tek cumle, dort deger, kaydirma isareti.
           Hepsi ORTADA, cunku kapi da kadrajin tam ortasinda
           (dunya x=386, viewBox merkezi de 386).
           Olculdu: fotografin kendi parlaklik merkezi kapidan yalnizca
           6 birim sapiyor, yani resim dengeli. Ama sag kolonlu
           duzende ekrandaki yazi murekkebinin agirlik merkezi
           %75,6'da kaliyordu; kapinin merkezde durmadigi izlenimini
           veren sey buydu. Ortalanan baslik bu farki kapatiyor.
           Isigin ne yaptigi burada anlatilmiyor: o scrollun isi.
           ============================================================ -->
      <article class="act act-cover is-on" data-act="0">
        {{kapak}}
      </article>

    <div class="stage-copy">
      {{aktlar}}
    </div>

    <div class="hud" id="hud" role="status" aria-live="off">
      {{hud}}
      <div class="hud-bar"><i id="hudBar"></i></div>
    </div>
  </div>
</section>

<!-- ============ CAYDIRMA ============ -->
<section class="band" id="caydirma">
  <div class="wrap">
    {{caydirma_basi}}

    <ol class="ladder">
      {{kademeler}}
    </ol>
  </div>
</section>

<!-- ============ ALGILAMA ============ -->
<section class="band band-alt" id="algilama">
  <div class="wrap geo">
    <div class="geo-text">
      {{algilama_metin}}

      <label class="slider">
        <span class="slider-top">
          {{kaydirici}}
          <output id="hOut">2,4 m</output>
        </span>
        <input type="range" id="hRange" min="2" max="3.5" step="0.1" value="2.4">
      </label>

      <dl class="geo-figs">
        {{geo_figurler}}
      </dl>
    </div>

    <svg class="geo-art" id="geoArt" viewBox="0 0 520 460" role="img" aria-labelledby="geoTitle">
      {{geo_baslik}}
      <g class="geo-grid" id="geoGrid"></g>
      <path id="geoWedge" class="geo-wedge" d=""/>
      <path id="geoEdgeL" class="geo-edge" d=""/>
      <path id="geoEdgeR" class="geo-edge" d=""/>
      <path id="geoArc" class="geo-arc" d=""/>
      <circle id="geoBlind" class="geo-blind" cx="260" cy="44" r="20"/>
      <g class="geo-house">
        <rect x="176" y="8" width="168" height="30" rx="2"/>
        <rect x="240" y="32" width="40" height="8"/>
      </g>
      <circle cx="260" cy="42" r="4" class="geo-sensor"/>
      <text x="260" y="26" class="geo-label">N1</text>
      <text id="geoReachLabel" x="260" y="0" class="geo-dim">11,8 m</text>
    </svg>
  </div>
</section>

<!-- ============ TEKNIK ============ -->
<section class="band" id="teknik">
  <div class="wrap">
    {{teknik_basi}}
    <table class="spec">
      {{teknik_caption}}
      <tbody>
        {{teknik_satirlar}}
      </tbody>
    </table>
  </div>
</section>

<!-- ============ MODELLER ============ -->
<section class="band band-alt" id="modeller">
  <div class="wrap">
    {{modeller_basi}}
    <div class="models">
      {{modeller}}
    </div>
  </div>
</section>

<!-- ============ KURULUM ============ -->
<section class="band" id="kurulum">
  <div class="wrap narrow">
    {{kurulum_basi}}
    <ol class="howto">
      {{kurulum_adimlar}}
    </ol>
  </div>
</section>

<footer class="foot">
  <div class="wrap foot-in">
    {{alt}}
  </div>
</footer>

</main>

{{betikler}}
</body>
</html>
